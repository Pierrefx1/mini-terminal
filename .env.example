# Copier ce fichier en .env puis renseigner les clés (toutes gratuites).
# FRED : https://fred.stlouisfed.org/docs/api/api_key.html  (macro US, projections Fed)
FRED_API_KEY=
# EIA (stocks de pétrole et de gaz, module matières premières), clé gratuite : https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# Options (OMON : chaîne, grecques, surface) : Tradier. Clé gratuite d'un compte développeur :
# https://developer.tradier.com (ou Tradier Brokerage) → Settings → API Access. TRADIER_ENV=sandbox (différé 15 min) ou production
TRADIER_API_KEY=
TRADIER_ENV=sandbox
# Optionnel : news supplémentaires / calendrier
FINNHUB_API_KEY=
# Récap marché IA du matin (Google Gemini) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle utilisé pour le récap (défaut gemini-3.8-flash)
RECAP_MODEL=gemini-3.8-flash
# Modèles de repli si le principal est saturé, séparés par des virgules
RECAP_FALLBACKS=gemini-3.7-flash,gemini-3.5-flash
# SEC EDGAR (fondamentaux sur 15 ans, FA) : la SEC exige un User-Agent avec un contact. Renseigner "Nom email@domaine"
SEC_USER_AGENT=
