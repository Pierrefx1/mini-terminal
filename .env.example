# Copier ce fichier en .env puis renseigner les clés (toutes gratuites).
# FRED : https://fred.stlouisfed.org/docs/api/api_key.html  (macro US, projections Fed)
FRED_API_KEY=
# Optionnel : news supplémentaires / calendrier
FINNHUB_API_KEY=
# Récap marché IA du matin (Google Gemini) : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modèle utilisé pour le récap (défaut gemini-3.8-flash)
RECAP_MODEL=gemini-3.8-flash
